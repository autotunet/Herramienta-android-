rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    // --- Note validation ---
    function isValidNote(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'content'])
        && data.id is string && data.id.size() > 0
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.content is string && data.content.size() <= 20000
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('isPinned' in data) || data.isPinned is bool)
        && (!('colorHex' in data) || (data.colorHex is string && data.colorHex.size() <= 16))
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // --- Task validation ---
    function isValidTask(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'isCompleted'])
        && data.id is string && data.id.size() > 0
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.isCompleted is bool
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('priority' in data) || (data.priority in ['LOW', 'MEDIUM', 'HIGH']))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 50))
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // --- Habit validation ---
    function isValidHabit(data) {
      return data.keys().hasAll(['id', 'userId', 'name'])
        && data.id is string && data.id.size() > 0
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && (!('targetDaysPerWeek' in data) || (data.targetDaysPerWeek is int && data.targetDaysPerWeek >= 1 && data.targetDaysPerWeek <= 7))
        && (!('streakCount' in data) || (data.streakCount is int && data.streakCount >= 0))
        && (!('lastCompletedDate' in data) || (data.lastCompletedDate is string && data.lastCompletedDate.size() <= 50))
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // --- Clipboard validation ---
    function isValidClipboard(data) {
      return data.keys().hasAll(['id', 'userId', 'snippet'])
        && data.id is string && data.id.size() > 0
        && data.userId is string && data.userId == request.auth.uid
        && data.snippet is string && data.snippet.size() <= 20000
        && (!('sourceLabel' in data) || (data.sourceLabel is string && data.sourceLabel.size() <= 100))
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // --- Device validation ---
    function isValidDevice(data) {
      return data.keys().hasAll(['id', 'userId', 'deviceName'])
        && data.id is string && data.id.size() > 0
        && data.userId is string && data.userId == request.auth.uid
        && data.deviceName is string && data.deviceName.size() <= 100
        && (!('model' in data) || (data.model is string && data.model.size() <= 100))
        && (!('appVersion' in data) || (data.appVersion is string && data.appVersion.size() <= 50))
        && (!('lastSyncTime' in data) || isValidTimestamp(data.lastSyncTime))
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt))
        && (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // --- Backup validation ---
    function isValidBackup(data) {
      return data.keys().hasAll(['id', 'userId', 'backupName'])
        && data.id is string && data.id.size() > 0
        && data.userId is string && data.userId == request.auth.uid
        && data.backupName is string && data.backupName.size() <= 100
        && (!('itemCount' in data) || (data.itemCount is int && data.itemCount >= 0))
        && (!('payloadSummary' in data) || (data.payloadSummary is string && data.payloadSummary.size() <= 5000))
        && (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // --- Collection Rules ---

    match /notes/{noteId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidNote(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && isValidNote(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /tasks/{taskId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidTask(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && isValidTask(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /habits/{habitId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidHabit(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && isValidHabit(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /clipboard/{clipId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidClipboard(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && isValidClipboard(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /devices/{deviceId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidDevice(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && isValidDevice(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /backups/{backupId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidBackup(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && isValidBackup(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
